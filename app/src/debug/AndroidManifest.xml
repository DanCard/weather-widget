<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only additions. This file is merged into debug builds only, so nothing declared here can
    reach a release APK — which is the primary lock on DebugLocationReceiver, a receiver that can
    move the app's idea of where the user is.

    android:exported="true" is required rather than incidental: `adb shell am broadcast` runs as the
    shell uid, and a non-exported receiver is unreachable from it even with an explicit component.
    That export is precisely why this must not exist outside a debug build.

    android:permission="android.permission.DUMP" is the second lock: the adb shell holds DUMP and
    ordinary apps cannot, so even on a debug phone no other installed app can move the location or
    trigger a billed sync through these receivers.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name="com.weatherwidget.debug.DebugLocationReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.weatherwidget.debug.SET_LOCATION" />
                <action android:name="com.weatherwidget.debug.CLEAR_LOCATION" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.weatherwidget.debug.DebugSyncReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.weatherwidget.debug.REFRESH" />
                <action android:name="com.weatherwidget.debug.FULL_SYNC" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
