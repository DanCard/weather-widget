    <string name="main_welcome">Bem-vindo ao Widget do Tempo</string>
    <string name="main_how_to_add_title">Como adicionar o widget</string>
    <string name="main_how_to_add_desc">1. Mantenha pressionado um espaço vazio na tela inicial.\n2. Toque em \"Widgets\".\n3. Encontre \"Weather Widget\" e arraste-o para a tela.</string>
    <string name="main_location_disclosure_title">Divulgação de localização</string>
    <string name="main_location_disclosure_desc">O Widget do Tempo coleta dados de localização para fornecer previsões locais mesmo quando o app está fechado ou fora de uso. Esses dados são usados apenas localmente no seu dispositivo para obter o clima preciso da sua posição atual.</string>
    <string name="background_location_disclosure_title">Acesso à localização em segundo plano</string>
    <string name="background_location_disclosure_desc">Para fornecer atualizações automáticas do clima no widget, este app precisa acessar sua localização mesmo em segundo plano.\n\nNa próxima tela, selecione \"Permitir o tempo todo\" para ativar as atualizações em segundo plano.</string>
    <string name="grant_location_permission">Conceder permissão de localização</string>
    <string name="open_settings">Abrir configurações</string>
    <string name="api_keys_title">Chaves de API</string>
    <string name="api_keys_description">Insira suas próprias chaves de API para serviços restritos. Serviços gratuitos (NWS, Open-Meteo) não exigem chaves.</string>
    <string name="api_key_hint">Inserir chave de API</string>
    <string name="get_api_key">Obter chave…</string>
