<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent rounded "glass" pill used for transient widget messages
     (e.g. the no-hourly-data notice shown on a day tap). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#E6222226" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="@color/surface_card_stroke" />
</shape>
