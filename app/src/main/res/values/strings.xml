    <string name="main_welcome">Welcome to Weather Widget</string>
    <string name="main_how_to_add_title">How to add the widget</string>
    <string name="main_how_to_add_desc">1. Long-press an empty spot on your home screen.\n2. Tap \"Widgets\".\n3. Find \"Weather Widget\" and drag it to your screen.</string>
    <string name="main_location_disclosure_title">Location Disclosure</string>
    <string name="main_location_disclosure_desc">Weather Widget collects location data to provide local weather forecasts even when the app is closed or not in use. This data is only used locally on your device to fetch accurate weather for your current position.</string>
    <string name="background_location_disclosure_title">Background Location Access</string>
    <string name="background_location_disclosure_desc">To provide automatic weather updates in your widget, this app needs access to your location even when it is in the background.\n\nOn the next screen, please select \"Allow all the time\" to enable background updates.</string>
