<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/current_observations_title"
            android:textColor="@color/widget_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/api_source_button"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/rounded_button_navy"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="32dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            tools:text="NWS"
            android:textColor="#4FC3F7"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/refresh_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/refresh"
            android:src="@drawable/ic_refresh"
            app:tint="@color/widget_text_primary" />

        <ImageButton
            android:id="@+id/settings_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings_gear"
            app:tint="@color/widget_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/blend_tab"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/blend_tab"
                android:textColor="#4FC3F7"
                android:textSize="16sp" />

            <View
                android:id="@+id/blend_tab_indicator"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#4FC3F7" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/observations_tab"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/current_observations_title"
                android:textColor="#AAAAAA"
                android:textSize="16sp" />

            <View
                android:id="@+id/observations_tab_indicator"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#4FC3F7"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fetch_logs_tab"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/fetch_logs"
                android:textColor="#AAAAAA"
                android:textSize="16sp" />

            <View
                android:id="@+id/fetch_logs_tab_indicator"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#4FC3F7"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#222226" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/observations_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!--
                Which feed supplies the displayed source's actuals. Shown only for a forecast-only
                source, which has none of its own and borrows one; hidden for sources that ship
                their own observations, since borrowing is a remedy for absence and the resolver
                refuses to override them. Sitting directly above the station list makes it the
                provenance disclosure as well as the control: the reader sees the chosen feed and
                the stations it produced in one glance.
            -->
            <LinearLayout
                android:id="@+id/actuals_source_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/rounded_button_navy"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="36dp"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/obs_actuals_source_label"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/actuals_source_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    tools:text="METAR"
                    android:textColor="#4FC3F7"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/obs_subtitle_nearby_stations"
                android:textColor="#AAAAAA"
                android:textSize="14sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/observations_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!--
            Vertical scroll for the rows, horizontal for the columns: at this font size the seven
            columns are wider than a phone screen, and they must not wrap or the table stops aligning.
        -->
        <ScrollView
            android:id="@+id/blend_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#0A0A0A"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/blend_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:text="@string/loading_logs"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TableLayout
                        android:id="@+id/blend_rows"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/blend_legend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="14dp"
                        android:textColor="#AAAAAA"
                        android:textSize="14sp" />
                </LinearLayout>
            </HorizontalScrollView>
        </ScrollView>

        <FrameLayout
            android:id="@+id/fetch_logs_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/fetch_logs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0A0A0A"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:scrollbars="vertical"
                android:text="@string/loading_logs"
                android:textColor="#00FF00"
                android:textSize="10sp" />
        </FrameLayout>
    </FrameLayout>

    <Button
        android:id="@+id/close_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#333333"
        android:text="@string/close"
        android:textColor="#FFFFFF" />

</LinearLayout>
