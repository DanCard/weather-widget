    <string name="main_welcome">Chào mừng đến với Tiện ích Thời tiết</string>
    <string name="main_how_to_add_title">Cách thêm tiện ích</string>
    <string name="main_how_to_add_desc">1. Nhấn giữ một chỗ trống trên màn hình chính.\n2. Nhấn \"Tiện ích\".\n3. Tìm \"Weather Widget\" và kéo vào màn hình.</string>
    <string name="main_location_disclosure_title">Thông báo về vị trí</string>
    <string name="main_location_disclosure_desc">Tiện ích Thời tiết thu thập dữ liệu vị trí để cung cấp dự báo thời tiết địa phương ngay cả khi ứng dụng đã đóng hoặc không sử dụng. Dữ liệu này chỉ được dùng cục bộ trên thiết bị của bạn để lấy thời tiết chính xác cho vị trí hiện tại.</string>
    <string name="background_location_disclosure_title">Truy cập vị trí trong nền</string>
    <string name="background_location_disclosure_desc">Để cập nhật thời tiết tự động trong tiện ích, ứng dụng này cần truy cập vị trí của bạn ngay cả khi chạy nền.\n\nỞ màn hình tiếp theo, hãy chọn \"Luôn cho phép\" để bật cập nhật nền.</string>
    <string name="grant_location_permission">Cấp quyền vị trí</string>
    <string name="open_settings">Mở cài đặt</string>
    <string name="api_keys_title">Khóa API</string>
    <string name="api_keys_description">Nhập khóa API riêng của bạn cho các dịch vụ hạn chế. Dịch vụ miễn phí (NWS, Open-Meteo) không cần khóa.</string>
    <string name="api_key_hint">Nhập khóa API</string>
    <string name="get_api_key">Lấy khóa…</string>
    <string name="get_api_key_no_browser">Không có trình duyệt. Đăng ký tại: %1$s</string>
    <string name="privacy_policy_title">Chính sách quyền riêng tư</string>
    <string name="allow">Cho phép</string>
    <string name="no_thanks">Không, cảm ơn</string>
    <string name="privacy_policy_body">Tiện ích Thời tiết thu thập dữ liệu vị trí để cung cấp dự báo thời tiết địa phương. Vị trí của bạn chỉ được dùng để lấy dữ liệu thời tiết cho khu vực của bạn và không bao giờ được lưu trữ hay chia sẻ với bên thứ ba, ngoại trừ các nhà cung cấp API thời tiết (NWS, Open-Meteo, v.v.) để lấy dự báo.\n\nChúng tôi dùng Firebase Crashlytics để theo dõi độ ổn định của ứng dụng. Dữ liệu này được ẩn danh.\n\nBạn có thể thu hồi quyền vị trí bất cứ lúc nào trong Cài đặt Android.\n\nCó thắc mắc, hãy truy cập: https://github.com/DanCard/weather-widget/issues</string>
