    <string name="main_welcome">欢迎使用天气小部件</string>
    <string name="main_how_to_add_title">如何添加小部件</string>
    <string name="main_how_to_add_desc">1. 长按主屏幕的空白处。\n2. 点按\"小部件\"。\n3. 找到\"Weather Widget\"并将其拖到屏幕上。</string>
    <string name="main_location_disclosure_title">位置信息声明</string>
    <string name="main_location_disclosure_desc">天气小部件会收集位置数据，以便在应用关闭或未使用时也能提供本地天气预报。这些数据仅在您的设备本地使用，用于获取您当前位置的准确天气。</string>
    <string name="background_location_disclosure_title">后台位置访问</string>
    <string name="background_location_disclosure_desc">为了在小部件中提供自动天气更新，此应用需要在后台也能访问您的位置。\n\n请在下一个屏幕中选择\"始终允许\"以启用后台更新。</string>
    <string name="grant_location_permission">授予位置权限</string>
    <string name="open_settings">打开设置</string>
    <string name="api_keys_title">API 密钥</string>
    <string name="api_keys_description">为受限服务输入您自己的 API 密钥。免费服务（NWS、Open-Meteo）无需密钥。</string>
    <string name="api_key_hint">输入 API 密钥</string>
    <string name="get_api_key">获取密钥…</string>
    <string name="get_api_key_no_browser">没有可用的浏览器。请前往注册：%1$s</string>
    <string name="privacy_policy_title">隐私政策</string>
    <string name="allow">允许</string>
    <string name="no_thanks">不用了</string>
    <string name="privacy_policy_body">天气小部件收集位置数据以提供本地天气预报。您的位置仅用于获取您所在地区的天气数据，除天气 API 提供商（NWS、Open-Meteo 等）用于获取预报外，绝不会被存储或与第三方共享。\n\n我们使用 Firebase Crashlytics 监控应用稳定性。这些数据已匿名化。\n\n您可以随时在 Android 设置中撤销位置权限。\n\n如有疑问，请访问：https://github.com/DanCard/weather-widget/issues</string>
